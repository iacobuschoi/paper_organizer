{
  "name": "paper-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "논문 정리 웹 — 맥 미니를 서버로, PDF · 메모 · 링크 · 라벨 · 그래프",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/server.test.js",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.pw-browsers node --test --test-concurrency=1 test/e2e.test.js",
    "setup:e2e": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.pw-browsers playwright install chromium-headless-shell",
    "set-password": "node server/set-password.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
